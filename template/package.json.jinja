{
  "name": {{ app_name | to_json }},
  "version": "0.1.0",
  "description": {{ app_description | to_json }},
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm run test && npm run build"{% if has_database %},
    "db:init": "node scripts/db/cli.mjs init",
    "db:up": "node scripts/db/cli.mjs up",
    "db:down": "node scripts/db/cli.mjs down",
    "db:status": "node scripts/db/cli.mjs status",
    "db:logs": "node scripts/db/cli.mjs logs",
    "db:migrate": "node scripts/db/cli.mjs migrate",
    "db:verify": "node scripts/db/cli.mjs verify",
    "db:lock": "node scripts/db/cli.mjs lock",{% if auth %}
    "db:roles": "node scripts/db/cli.mjs roles",{% endif %}
    "test:db": "vitest run --config vitest.db.config.mts"{% endif %}
  },
  "dependencies": {
    {% if forms %}"@hookform/resolvers": "5.9.2",
    {% endif %}{% if auth %}"better-auth": "1.7.15",
    {% endif %}"class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "lucide-react": "1.63.0",
    "next": "16.4.5",
    {% if has_database %}"pg": "8.23.1",
    {% endif %}"radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    {% if forms %}"react-hook-form": "7.91.0",
    {% endif %}{% if has_database %}"server-only": "0.0.1",
    {% endif %}"tw-animate-css": "1.4.0"{% if zod %},
    "zod": "4.6.7"{% endif %}
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.5",
    {% if forms %}"@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    {% endif %}"@types/node": "26.6.5",
    {% if has_database %}"@types/pg": "8.23.1",
    {% endif %}"@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "10.1.8",
    {% if forms %}"jsdom": "30.1.3",
    {% endif %}"prettier": "3.9.10",
    "shadcn": "4.23.0",
    {% if database == 'supabase' %}"supabase": "2.122.1",
    {% endif %}"tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=26 <27"
  }
}

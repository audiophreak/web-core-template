# Local development settings. `npm run db:init` creates .env.local from this shape and never overwrites it.
# .env.local is git-ignored: do not commit it, and never put a production credential in it.
{% if database == 'postgres' %}POSTGRES_USER=app
POSTGRES_PASSWORD=generated-by-npm-run-db-init
POSTGRES_DB=app
POSTGRES_PORT=5432
DATABASE_URL=postgresql://app:generated-by-npm-run-db-init@127.0.0.1:5432/app
{% else %}# The local Supabase stack's documented defaults (127.0.0.1 only). They are not secrets and do not
# apply to any hosted project.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
{% endif %}{% if auth %}
# The administrative connection above (DATABASE_URL) is for migrations, tests and tools only. The running
# application connects as the least-privilege role app_runtime with its own password, and refuses to start
# its database work as an owner or administrator. npm run db:init creates the real values.
DATABASE_RUNTIME_URL={% if database == 'postgres' %}postgresql://app_runtime:generated-by-npm-run-db-init@127.0.0.1:5432/app{% else %}postgresql://app_runtime:generated-by-npm-run-db-init@127.0.0.1:54322/postgres{% endif %}

# Authentication. There is no default secret: init generates a random one into the git-ignored .env.local, and
# the application refuses a missing, short or placeholder value. BETTER_AUTH_URL is where the application is
# served; it and AUTH_TRUSTED_ORIGINS are the only origins trusted for sign-in and for changing data.
BETTER_AUTH_SECRET=generated-by-npm-run-db-init
BETTER_AUTH_URL=http://localhost:3000
# AUTH_TRUSTED_ORIGINS=https://admin.example.com
# AUTH_ALLOW_SIGN_UP=true
# AUTH_TRUSTED_IP_HEADER=x-forwarded-for
# AUTH_TRUSTED_PROXIES=10.0.0.0/8
{% endif %}
# Optional tuning (milliseconds, and a pool size from 1 to 20):
# DATABASE_POOL_MAX=5
# DATABASE_CONNECT_TIMEOUT_MS=5000
# DATABASE_STATEMENT_TIMEOUT_MS=10000

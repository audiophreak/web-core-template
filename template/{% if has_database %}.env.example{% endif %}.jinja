# Local development settings. `npm run db:init` creates .env.local from this shape and never overwrites it.
# .env.local is git-ignored: do not commit it, and never put a production credential in it.
{% if database == 'postgres' %}POSTGRES_USER=app
POSTGRES_PASSWORD=generated-by-npm-run-db-init
POSTGRES_DB=app
POSTGRES_PORT=5432
DATABASE_URL=postgresql://app:generated-by-npm-run-db-init@127.0.0.1:5432/app
{% else %}# The local Supabase stack's documented defaults (127.0.0.1 only). They are not secrets and do not
# apply to any hosted project.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
{% endif %}
# Optional tuning (milliseconds, and a pool size from 1 to 20):
# DATABASE_POOL_MAX=5
# DATABASE_CONNECT_TIMEOUT_MS=5000
# DATABASE_STATEMENT_TIMEOUT_MS=10000

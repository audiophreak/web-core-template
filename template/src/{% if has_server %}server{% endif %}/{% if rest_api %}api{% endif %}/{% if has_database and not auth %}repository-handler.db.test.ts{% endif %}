import { afterAll, beforeAll, describe, expect, it } from "vitest";
import { z } from "zod";
import { createItemInputSchema, itemIdSchema, type Item } from "@/lib/schemas";
import { problemDetailsSchema } from "@/lib/schemas/v1";
import { DatabaseError, closePool } from "@/server/db";
import {
  createTestDatabase,
  type TestDatabase,
} from "@/server/db/test-support/database";
import { createItem, getItem } from "@/server/items/repository";
import { readJson, toFieldErrors } from "@/server/api/request";
import { guarded, json, problem } from "@/server/api/responses";

/**
 * Shows that the REST API helpers and the repository compose: a handler that reads a body defensively,
 * validates it with the shared schema, calls the repository and answers with `json()` / `problem()`.
 * The handler lives in this test on purpose. Authentication does not exist yet, so no route in the
 * application may reach the database (src/server/db/server-only.test.ts enforces that).
 */
const itemResponseSchema = z.strictObject({
  id: itemIdSchema,
  title: z.string(),
  body: z.string(),
});
const view = (item: Item) => ({
  id: item.id,
  title: item.title,
  body: item.body,
});

const create = guarded(async (request: Request) => {
  const body = await readJson(request, 8 * 1024);
  if (!body.ok) return body.response;
  const parsed = createItemInputSchema.safeParse(body.data);
  if (!parsed.success)
    return problem("validation_failed", {
      errors: toFieldErrors(parsed.error),
    });
  try {
    return json(itemResponseSchema, view(await createItem(parsed.data)), {
      status: 201,
    });
  } catch (error) {
    if (error instanceof DatabaseError && error.code === "conflict") {
      return problem("validation_failed", {
        errors: [
          { path: "title", message: "An item with this title already exists" },
        ],
      });
    }
    throw error; // anything else becomes the generic internal_error problem
  }
});

const read = guarded(async (request: Request) => {
  try {
    return json(
      itemResponseSchema,
      view(await getItem(new URL(request.url).searchParams.get("id") ?? "")),
    );
  } catch (error) {
    if (error instanceof DatabaseError && error.code === "not_found")
      return problem("not_found");
    if (error instanceof DatabaseError && error.code === "invalid_input")
      return problem("validation_failed", {
        errors: [{ path: "id", message: "Not a valid id" }],
      });
    throw error;
  }
});

const post = (body: string, type = "application/json") =>
  new Request("http://localhost/api/v1/items", {
    method: "POST",
    headers: { "content-type": type },
    body,
  });

let database: TestDatabase;

beforeAll(async () => {
  database = await createTestDatabase();
  process.env.DATABASE_URL = database.url;
});

afterAll(async () => {
  await closePool();
  await database.drop();
});

describe("a handler built from the REST API helpers and the repository", () => {
  it("creates an item and answers with the explicit response schema", async () => {
    const response = await create(
      post(JSON.stringify({ title: "From a handler", body: "hello" })),
    );

    expect(response.status).toBe(201);
    expect(response.headers.get("content-type")).toBe(
      "application/json; charset=utf-8",
    );
    const body = itemResponseSchema.parse(await response.json());
    expect(Object.keys(body).sort()).toEqual(["body", "id", "title"]); // no timestamps or internals
    const found = await read(
      new Request(`http://localhost/api/v1/items?id=${body.id}`),
    );
    expect(await found.json()).toEqual(body);
  });

  it("reports invalid input, malformed JSON and a wrong media type with the standard problems", async () => {
    const invalid = await create(
      post(JSON.stringify({ title: "", unexpected: "SENTINEL-VALUE" })),
    );
    expect(invalid.status).toBe(422);
    expect(problemDetailsSchema.parse(await invalid.clone().json()).code).toBe(
      "validation_failed",
    );
    expect(await invalid.text()).not.toContain("SENTINEL-VALUE");
    expect((await create(post("{oops"))).status).toBe(400);
    expect((await create(post("{}", "text/plain"))).status).toBe(415);
  });

  it("maps a duplicate to a field error without repeating the stored data", async () => {
    await create(post(JSON.stringify({ title: "Duplicate Me" })));

    const response = await create(
      post(JSON.stringify({ title: "duplicate me" })),
    );

    expect(response.status).toBe(422);
    expect(JSON.stringify(await response.json())).not.toMatch(/duplicate me/i);
  });

  it("answers not_found for a missing item and validation_failed for a malformed id", async () => {
    expect(
      (
        await read(
          new Request(
            "http://localhost/api/v1/items?id=00000000-0000-4000-8000-000000000000",
          ),
        )
      ).status,
    ).toBe(404);
    expect(
      (await read(new Request("http://localhost/api/v1/items?id=1%20or%201=1")))
        .status,
    ).toBe(422);
  });

  it("turns a database failure into the generic internal_error without leaking anything", async () => {
    await closePool();
    process.env.DATABASE_URL =
      "postgresql://app:s3cr3t-handler@127.0.0.1:1/app";
    process.env.DATABASE_CONNECT_TIMEOUT_MS = "1000";

    const response = await create(
      post(JSON.stringify({ title: "Cannot be stored" })),
    );
    const text = await response.text();

    expect(response.status).toBe(500);
    expect(problemDetailsSchema.parse(JSON.parse(text)).code).toBe(
      "internal_error",
    );
    expect(text).not.toMatch(/s3cr3t|127\.0\.0\.1|ECONNREFUSED|postgres/i);
    await closePool();
    process.env.DATABASE_URL = database.url;
  });
});

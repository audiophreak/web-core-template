{% set DB_URL_VAR = 'DATABASE_RUNTIME_URL' if auth else 'DATABASE_URL' %}import { describe, expect, it } from "vitest";
import { DatabaseConfigError, loadDatabaseConfig } from "@/server/db/config";

const URL = "postgresql://app:s3cr3t-pass@127.0.0.1:5432/app";

describe("loadDatabaseConfig", () => {
  it("reads the connection string and applies bounded defaults", () => {
    expect(loadDatabaseConfig({ {{ DB_URL_VAR }}: URL })).toEqual({
      connectionString: URL,
      poolMax: 5,
      connectTimeoutMs: 5_000,
      statementTimeoutMs: 10_000,
    });
  });

  it("accepts postgres:// and explicit tuning within its bounds", () => {
    const config = loadDatabaseConfig({
      {{ DB_URL_VAR }}: "postgres://u@localhost/db",
      DATABASE_POOL_MAX: "20",
      DATABASE_CONNECT_TIMEOUT_MS: "100",
      DATABASE_STATEMENT_TIMEOUT_MS: "300000",
    });
    expect([
      config.poolMax,
      config.connectTimeoutMs,
      config.statementTimeoutMs,
    ]).toEqual([20, 100, 300_000]);
  });

  it.each([
    ["a missing URL", {}, ["{{ DB_URL_VAR }}"]],
    ["an empty URL", { {{ DB_URL_VAR }}: "" }, ["{{ DB_URL_VAR }}"]],
    [
      "a URL that is not PostgreSQL",
      { {{ DB_URL_VAR }}: "mysql://u:s3cr3t-pass@h/db" },
      ["{{ DB_URL_VAR }}"],
    ],
    [
      "text that is not a URL",
      { {{ DB_URL_VAR }}: "s3cr3t-pass" },
      ["{{ DB_URL_VAR }}"],
    ],
    [
      "a pool of zero",
      { {{ DB_URL_VAR }}: URL, DATABASE_POOL_MAX: "0" },
      ["DATABASE_POOL_MAX"],
    ],
    [
      "a pool over the limit",
      { {{ DB_URL_VAR }}: URL, DATABASE_POOL_MAX: "21" },
      ["DATABASE_POOL_MAX"],
    ],
    [
      "a pool that is not a number",
      { {{ DB_URL_VAR }}: URL, DATABASE_POOL_MAX: "many" },
      ["DATABASE_POOL_MAX"],
    ],
    [
      "an empty pool value",
      { {{ DB_URL_VAR }}: URL, DATABASE_POOL_MAX: "" },
      ["DATABASE_POOL_MAX"],
    ],
    [
      "a connect timeout that is too small",
      { {{ DB_URL_VAR }}: URL, DATABASE_CONNECT_TIMEOUT_MS: "5" },
      ["DATABASE_CONNECT_TIMEOUT_MS"],
    ],
    [
      "an unbounded statement timeout",
      { {{ DB_URL_VAR }}: URL, DATABASE_STATEMENT_TIMEOUT_MS: "999999999" },
      ["DATABASE_STATEMENT_TIMEOUT_MS"],
    ],
    [
      "several problems at once",
      { DATABASE_POOL_MAX: "0", DATABASE_STATEMENT_TIMEOUT_MS: "1" },
{% if auth %}      [
        "DATABASE_RUNTIME_URL",
        "DATABASE_POOL_MAX",
        "DATABASE_STATEMENT_TIMEOUT_MS",
      ],{% else %}      ["DATABASE_URL", "DATABASE_POOL_MAX", "DATABASE_STATEMENT_TIMEOUT_MS"],{% endif %}
    ],
  ])("rejects %s and names only the variables", (_label, env, variables) => {
    let error: unknown;
    try {
      loadDatabaseConfig(env);
    } catch (caught) {
      error = caught;
    }
    expect(error).toBeInstanceOf(DatabaseConfigError);
    expect((error as DatabaseConfigError).variables).toEqual(variables);
    expect((error as Error).message).not.toContain("s3cr3t-pass");
  });
});

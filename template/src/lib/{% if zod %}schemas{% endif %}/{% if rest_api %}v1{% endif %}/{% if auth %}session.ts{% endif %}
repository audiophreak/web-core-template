import { z } from "zod";

/**
 * GET /api/v1/session and GET /api/v1/sessions: what a signed-in caller may learn about their own
 * account and sessions. Session tokens, password hashes and provider rows are never part of a response.
 */
export const sessionResponseSchema = z.strictObject({
  user: z.strictObject({
    id: z.string().min(1).max(100),
    email: z.string().max(320),
    name: z.string().max(200),
  }),
  session: z.strictObject({ expiresAt: z.iso.datetime() }),
});

export const sessionListResponseSchema = z.strictObject({
  sessions: z
    .array(
      z.strictObject({
        id: z.string().min(1).max(100),
        createdAt: z.iso.datetime(),
        expiresAt: z.iso.datetime(),
        userAgent: z.string().max(300).nullable(),
        current: z.boolean(),
      }),
    )
    .max(100),
});

export type SessionResponse = z.infer<typeof sessionResponseSchema>;
